APP_NAME=FoodPoint
APP_ENV=production
APP_KEY=base64:tVbL3uIJRN7gHa0JsUN6s649umvNokzemjoGv3AN37A=
APP_DEBUG=false
APP_URL=https://api.uzaziclinic.co.tz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL Database (cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_db_name
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@uzaziclinic.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Snippe Payment Gateway
SNIPPE_API_KEY=snp_your_api_key_here
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_VERSION=2026-01-25
SNIPPE_WEBHOOK_SECRET=your_webhook_signing_secret
